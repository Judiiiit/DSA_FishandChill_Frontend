<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_rod_card"
        android:padding="8dp"
        android:layout_margin="4dp">

        <TextView
            android:id="@+id/tvRodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Caña básica"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pixel_font"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRodDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Speed: 1  Power: 1  Rarity: Common"
            android:textSize="11sp"
            android:textColor="#DDDDDD"
            android:fontFamily="@font/pixel_font"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRodPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Price: 100"
                android:textSize="12sp"
                android:textColor="#FFC107"
                android:fontFamily="@font/pixel_font"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnBuy"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/pixel_button_bg"
                android:src="@android:drawable/ic_menu_add"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="Comprar" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
